[Icon Theme]
Name=OldNet
Comment=OldNet OS icon theme (palette A)
Inherits=breeze-dark,breeze,hicolor
Directories=scalable/places,scalable/apps,scalable/actions

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/actions]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Actions
