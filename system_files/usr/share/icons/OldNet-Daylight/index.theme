[Icon Theme]
Name=OldNet-Daylight
Comment=OldNet OS icon theme (palette LIGHT)
Inherits=breeze,breeze-dark,hicolor
Directories=scalable/places,scalable/apps,scalable/actions

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/actions]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Actions
